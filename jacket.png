</span></span><span><span>    emp_id</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span>
</span></span><span><span>    </span><span class="token token" style="color: rgb(112, 184, 255);">SUM</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>FLOOR</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span>UNIX_TIMESTAMP</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(112, 184, 255);">MAX</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(204, 123, 244);">timestamp</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">-</span><span> UNIX_TIMESTAMP</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(112, 184, 255);">MIN</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(204, 123, 244);">timestamp</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">/</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">3600</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(204, 123, 244);">AS</span><span> hours_worked
</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">FROM</span><span> attendance
</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">WHERE</span><span> DAYOFWEEK</span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(204, 123, 244);">timestamp</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">IN</span><span> </span><span class="token token" style="color: rgb(211, 215, 222);">(</span><span class="token token" style="color: rgb(94, 237, 237);">1</span><span class="token token" style="color: rgb(211, 215, 222);">,</span><span> </span><span class="token token" style="color: rgb(94, 237, 237);">7</span><span class="token token" style="color: rgb(211, 215, 222);">)</span><span>  </span><span class="token token" style="color: rgb(129, 136, 152);">-- 1 = Sunday, 7 = Saturday</span><span>
