</span></span><span><span></span><span class="token token" style="color: rgb(204, 123, 244);">WHERE</span><span> CITY </span><span class="token token" style="color: rgb(234, 236, 240);">NOT</span><span> </span><span class="token token" style="color: rgb(234, 236, 240);">RLIKE</span><span> </span><span class="token token" style="color: rgb(155, 233, 99);">'^[AEIOUaeiou].*[AEIOUaeiou]$'</span><span class="token token" style="color: rgb(211, 215, 222);">;</span></span></code></pre></div></div>
